{
  "name": "mizore-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn icons:generate && cross-env NODE_ENV=development INIT_CWD=$PWD next dev --port 3000",
    "clean": "node ./scripts/clean.mjs",
    "build": "yarn icons:generate && yarn clean && yarn contentlayer2 build && cross-env INIT_CWD=$PWD next build && node ./scripts/postbuild.mjs",
    "preview": "node ./scripts/preview-static.mjs",
    "lint": "yarn lint:check",
    "lint:check": "eslint app components contentlayer data lib layouts scripts contentlayer.config.ts eslint.config.mjs next.config.js postcss.config.js prettier.config.js",
    "lint:fix": "yarn lint:check --fix",
    "typecheck": "tsc --noEmit --pretty false",
    "quality:html": "scripts/quality-html.sh out",
    "size:report": "node ./scripts/asset-report.mjs",
    "size:budget": "node ./scripts/asset-budget.mjs",
    "images:optimize": "node ./scripts/optimize-images.mjs",
    "icons:generate": "node ./scripts/generate-lucide-icons.mjs",
    "icons:check": "node ./scripts/generate-lucide-icons.mjs --check",
    "check": "yarn icons:check && yarn lint:check && yarn typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "contentlayer2": "0.5.8",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.21.0",
    "next": "15.5.12",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-preset-minify": "7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.18.0",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.+(json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
