{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "next.config.js",
    "playwright.config.ts",
    "vitest.config.ts",
    "contentlayer.config.ts",
    "app/**/*.{ts,tsx}",
    "contentlayer/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "contentlayer/**/*.{ts,tsx}",
    "contentlayer.config.ts",
    "data/**/*.{ts,tsx}",
    "layouts/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "next.config.js",
    "playwright.config.ts",
    "postcss.config.js",
    "prettier.config.js",
    "scripts/**/*.{js,mjs}",
    "tests/**/*.{ts,tsx}",
    "vitest.config.ts"
  ],
  "ignoreBinaries": ["scripts/quality-html.sh"],
  "ignoreDependencies": [
    "@tailwindcss/typography",
    "eslint-config-next",
    "eslint-config-prettier",
    "eslint-plugin-jsx-a11y",
    "sharp",
    "tailwindcss"
  ]
}
